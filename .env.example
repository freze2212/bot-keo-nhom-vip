# === Game / Vision (Chrome GUI — không Playwright) ===
DOMAIN="https://www.example.com"
ROUTER_URL_BACARAT_SEXY="/seamless?gameType=LIVE"
USERNAME_ACCOUNT=""
PASSWORD_ACCOUNT=""

# === Server + Panel ===
SERVER_HOSTNAME="http://localhost"
SERVER_PORT=3201
SERVER_BIND=0.0.0.0
API_BASE_URL=http://localhost:3201
API_KEY="your-static-api-key"
PANEL_PUBLIC_URL=http://localhost:3201/panel/
PANEL_ADMIN_KEY=admin-change-me
TRUST_PROXY=0

# Khi vision local + forward/server trên VPS: trỏ API_BASE_URL / SERVER_HOSTNAME
# tới https://domain-vps và bật upload ảnh (xem bên dưới).
UPLOAD_SHOTS=0
# UPLOAD_SHOTS=1 → vision đẩy ảnh crop/JPEG lên /api/upload-screenshot

URL_CONNECT_MONGODB="mongodb://user:pass@host:27017/db_bacarat"
JWT_SECRET="change-me"

# === Telegram (alert server / fallback; account forward nằm tele_forward_accounts.json) ===
TOKEN_BOT=""
ID_TELEGRAM_RECIPIENT=""
GROUP=""
PRIORITY_ROUND_GROUPS=""

# Telethon (nếu login userbot trên máy này)
API_ID=
API_HASH=
PHONE=

# === Tuning ===
LOGS_SERVER_SEXY="logs_server_sexy"
SERVER_VERBOSE_LOG=false
POLL_INTERVAL_MS=2000
MAX_TOTAL_ROUNDS_PER_TABLE=400
BET_AMOUNT=50
UNIT_DISPLAY=50
